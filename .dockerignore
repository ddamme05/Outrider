# Send only required application and dashboard files to Docker builds.
# Ignore everything first, then allow the paths copied by the Dockerfiles.
# The exclusions below keep deployment secrets, seed dumps and build output
# out of the context. Keep this allowlist aligned with the COPY instructions.

*

!src
!db
!dashboard
!deploy
!pyproject.toml
!uv.lock
!alembic.ini
!LICENSE

# Re-exclude secrets / runtime files / build-noise within the un-ignored paths.
deploy/.env
deploy/.env.*
deploy/demo_seed.sql
dashboard/node_modules
dashboard/dist
**/__pycache__
**/*.pyc
